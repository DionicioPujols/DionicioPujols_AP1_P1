@page "/Model1/Index"

@inject AutorService autorService
@inject ToastService toastService

<PageTitle>Registro de autores</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de autores</h5>
            <a href="/Model1/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong> Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong> Busqueda</strong></label>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                <div class="grid">
                    <QuickGrid Items="@AutorQueryable" class="table table-hover table-striped">
                        <PropertyColumn Property="@(a => a.IdAutor)" title="AutorId" Sortable="true"/>
                        <PropertyColumn Property="@(a => a.Nombre)" title="Nombre" Sortable="true" />
                        <PropertyColumn Property="@(a => a.Nacionalidad)" title="Nacionalidad" Sortable="true" />
                        <PropertyColumn Property="@(a => a.FechaNacimiento)" title="FechaNacimiento" Format="dd/mm/yyyy" Sortable="true" />
                        <PropertyColumn Property="@(a => a.sueldo)" title="sueldo" Sortable="true" />
                        <TemplateColumn title="Opciones" Align="Align.Center">
                            <a href="/Model1/Edit/@context.IdAutor" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i></a>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between align-items-center">
                <label class="mb-0">Cantidad: @ListaAutores.Count()</label>
                <label class="mb-0">Total Acumulado: @ListaAutores.Sum(a => a.sueldo)</label>
            </div>
        </div>
    </div>
</div>
@code {
    public List<Autor> ListaAutores { get; set; } = new List<Autor>();
    IQueryable<Autor>? AutorQueryable;

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    private int AutorIdDelete;

    protected override async Task OnInitializedAsync()
    {
        ListaAutores = await autorService.GetList(a => true);
        AutorQueryable = ListaAutores.AsQueryable();
    }

    public async Task Buscar()
    {
        if (ValorFiltro != "")
        {
            if (Filtro == "Nombre")
            {
                ListaAutores = await autorService.GetList(a => a.Nombre!.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Nacionalidad")
            {
                ListaAutores = await autorService.GetList(a => a.Nacionalidad!.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
            ListaAutores = await autorService.GetList(a => true);

        AutorQueryable = ListaAutores.AsQueryable();
    }
}
