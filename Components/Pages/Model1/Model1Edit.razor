@page "/Model1/Edit/{AutorId:int}"

@inject AutorService autorService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Modificar Autor</PageTitle>
<EditForm Model="autor" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Autor</h5>
            </div>

            <div class="card-body">

                @*Autor*@
                <div class="mt-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="autor.Nombre"></InputText>
                    <ValidationMessage For="(() => autor.Nombre)" />
                </div>

                @*Nacionalidad*@
                <div class="mt-3">
                    <label class="form-label"><strong>Nacionalidad</strong></label>
                    <InputText class="form-control" @bind-Value="autor.Nacionalidad"></InputText>
                    <ValidationMessage For="(() => autor.Nacionalidad)" />
                </div>

                @*FechaNacimiento*@
                <div class="mt-3">
                    <label class="form-label"><strong>Fecha de nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="autor.FechaNacimiento"></InputDate>
                    <ValidationMessage For="(() => autor.FechaNacimiento)" />
                </div>

                @*sueldo*@
                <div class="mt-3">
                    <label class="form-label"><strong>Sueldo</strong></label>
                    <InputNumber class="form-control" @bind-Value="autor.sueldo"></InputNumber>
                    <ValidationMessage For="(() => autor.sueldo)" />
                </div>
            </div>

            <div class="card-footer text-center">
                <a href="/Model1/Index/" class="btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i>Volver</a>
                <button type="submit" class="btn btn-primary m-2"><i class="bi bi-floppy"></i> Guardar</button>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModalLabel"<i class="bi bi-trash"></i></button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteModalLabel">Confirmar Eliminación</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar este registro de autor?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="EliminarAutor">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int AutorId { get; set; }

    public Autor autor { get; set; } = new Autor();

    protected override async Task OnInitializedAsync()
    {
        autor = await autorService.Buscar(AutorId) ?? new Autor();
    }

    public async Task Modificar()
    {
        autor.Nombre = autor.Nombre!.Trim();
        var ExisteNombre = await autorService.GetList(a => a.Nombre!.ToLower() == autor.Nombre.ToLower() && a.IdAutor != autor.IdAutor);
        if (ExisteNombre.Any())
        {
            toastService.ShowError("Ya existe un autor con este nombre");
            return;
        }
        var Modificado = await autorService.Guardar(autor);
        if (Modificado)
        {
            toastService.ShowSuccess("El registro del autor fue modificado correctamente");
            navigationManager.NavigateTo("/Model1/Index");
        }
        else
        {
            toastService.ShowError("No se pudo modificar el registro del autor");
        }
    }

    public async Task EliminarAutor()
    {
        var Eliminado = await autorService.Eliminar(AutorId);
        if (Eliminado)
        {
            toastService.ShowSuccess("El Autor fue eliminado correctamente!");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el autor del registro!");
        }
    }
}
